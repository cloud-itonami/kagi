;; Regulatory source register for KAGI — the key-less half of a governed
;; vault (cloud-itonami/kagi).
;;
;; blueprint.edn declares this mount's domain :security/secrets-governance
;; with :post-quantum among its social impacts, and its invariant is "never
;; receives a secret". Until this file existed, no cryptographic claim in the
;; repository — which key-encapsulation standard the DEK-sealing design
;; assumes, which authority grades the ciphers an operator may choose — could
;; be traced to anything. This is that list.
;;
;; Shape is tx-data (a vector of entity maps), like every other EDN corpus in
;; this workspace, so it loads with
;;   (d/transact conn (edn/read-string (slurp "facts.edn")))
;; :source/id is the join key. A standard or page not in this table has NO
;; spec-basis for this repository -- extend the table, never invent an id or
;; a URL.
;;
;; VERIFIED BY `nbb scripts/verify-facts.cljs`, which re-fetches every entry.
;; Each carries a :source/verify tag naming WHICH check establishes it:
;;   :page-identity  2xx, final URL still the page asked for, declared
;;                   charset, and the <title> recorded below.
;;   :page-text      All of :page-identity, plus every string in
;;                   :page/must-contain present in the de-tagged body.
;;
;; NO LAW IS CITED. Unlike the sibling ministry registers, this repository's
;; regulatory surface is standards bodies, not statutes: NIST, OWASP,
;; CRYPTREC and the IETF. Nothing in facts.edn asserts Japanese legal
;; obligations, because none was read.
;;
;; THE HOST ASSUMPTIONS ARE MEASURED AT RUN TIME, NOT DATED IN A COMMENT.
;; The :host-behaviour entities below say what each host does with a path
;; that does not exist. The verifier fetches a nonexistent path on every host
;; in the register and fails if the answer has changed.
;;
;; ALL FOUR HOSTS ANSWER **404** FOR A PATH THAT DOES NOT EXIST, AND NONE OF
;; THE FOUR IS BEHIND A BOT CHALLENGE for a paced, serial client. That is the
;; opposite of the METI/MLIT ministry hosts the pattern was built on, where
;; the challenge IS a 2xx. This register is the easy case -- which is itself
;; worth writing down: an easy host is not evidence that the checks are
;; unnecessary, and the verifier still refuses when a challenge appears.
;;
;; :source/covers says why an entry is in a secrets-governance register.
;; Claims stop at the level actually checked -- document identity, and for
;; the :page-text entries the strings read on 2026-08-31. No algorithm
;; parameters, no section text, and no conformance claim is asserted, because
;; none of that was read.

[
 ;; ── What each host does with a path that does not exist ────────────────────
 ;; Re-measured on every run. A change here invalidates the check that rests
 ;; on it, which is the point of writing it down as data.

 {:source/id "host.csrc-nist-gov"
  :source/kind :host-behaviour
  :host/name "csrc.nist.gov"
  :host/missing-path :refuses
  :host/missing-status 404
  :source/note "NIST CSRC. Answers 404 with a real 'Page Not Found | CSRC'
                page (~35 KB) at the requested URL, so status and title both
                separate a real page from an invented one. Two of the five
                cited standards live here."}

 {:source/id "host.cheatsheetseries-owasp-org"
  :source/kind :host-behaviour
  :host/name "cheatsheetseries.owasp.org"
  :host/missing-path :refuses
  :host/missing-status 404
  :source/note "OWASP Cheat Sheet Series. Answers 404 with a small (~4 KB)
                generic page titled '404' at the requested URL. The body is a
                template, so the title alone is thin; the status is what
                discriminates."}

 {:source/id "host.cryptrec-go-jp"
  :source/kind :host-behaviour
  :host/name "www.cryptrec.go.jp"
  :host/missing-path :refuses
  :host/missing-status 404
  :source/note "CRYPTREC (デジタル庁/総務省/経済産業省 joint project). Answers
                404 with a 196-byte bare '404 Not Found' body at the
                requested URL -- no site chrome at all, so byte count and
                title are both thin and the status is what discriminates."}

 {:source/id "host.rfc-editor-org"
  :source/kind :host-behaviour
  :host/name "www.rfc-editor.org"
  :host/missing-path :refuses
  :host/missing-status 404
  :source/note "RFC Editor. Answers 404 with a 15-byte body (no <title> at
                all) at the requested URL. The thinnest refusal in this
                register; again the status is what discriminates."}

 ;; ── Key management: the standard the vault's key hierarchy is graded by ────

 {:source/id "std.sp800-57"
  :source/kind :standard
  :source/title "NIST SP 800-57 Part 1 Rev. 5, Recommendation for Key Management"
  :source/publisher "NIST Computer Security Resource Center"
  :source/url "https://csrc.nist.gov/pubs/sp/800/57/pt1/r5/final"
  :source/verify :page-identity
  :page/title "SP 800-57 Part 1 Rev. 5, Recommendation for Key Management: Part 1 – General | CSRC"
  :source/retrieved-at "2026-08-31"
  :source/covers #{:key-management :key-lifecycle}
  :source/note "The NIST key-management recommendation the vault's key
                hierarchy (root key -> VMK -> per-item DEKs) is graded
                against. Identity only: key lifetimes, the 128-bit security
                strength floor and the rotation guidance are section text
                and are NOT asserted here, because none was read."}

 {:source/id "std.sp800-131a"
  :source/kind :standard
  :source/title "NIST SP 800-131A Rev. 2, Transitioning the Use of Cryptographic Algorithms and Key Lengths"
  :source/publisher "NIST Computer Security Resource Center"
  :source/url "https://csrc.nist.gov/pubs/sp/800/131/a/r2/final"
  :source/verify :page-identity
  :page/title "SP 800-131A Rev. 2, Transitioning the Use of Cryptographic Algorithms and Key Lengths | CSRC"
  :source/retrieved-at "2026-08-31"
  :source/covers #{:key-management :crypto-transitions}
  :source/note "The NIST transition standard -- the instrument that grades
                which algorithms and key lengths are still acceptable and
                which are deprecated. Identity only: which algorithms are
                disallowed as of which dates is section text and is NOT
                asserted, because none was read."}

 ;; ── Post-quantum: the KEM the blueprint's :post-quantum impact names ───────

 {:source/id "std.fips203"
  :source/kind :standard
  :source/title "NIST FIPS 203, Module-Lattice-Based Key-Encapsulation Mechanism Standard"
  :source/publisher "NIST Computer Security Resource Center"
  :source/url "https://csrc.nist.gov/pubs/fips/203/final"
  :source/verify :page-text
  :page/title "FIPS 203, Module-Lattice-Based Key-Encapsulation Mechanism Standard | CSRC"
  :page/must-contain ["ML-KEM"
                      "ML-KEM-512, ML-KEM-768, and ML-KEM-1024"]
  :source/retrieved-at "2026-08-31"
  :source/covers #{:key-management :post-quantum}
  :source/note "ML-KEM, the NIST post-quantum KEM standard -- the instrument
                that makes a :post-quantum claim about this vault's sealing
                design gradeable. The strings checked are the algorithm name
                and the three parameter-set names; which parameter set this
                repository uses is a design claim and is NOT asserted by the
                register."}

 ;; ── Operational guidance: key storage practice ────────────────────────────

 {:source/id "page.owasp-crypto-storage"
  :source/kind :guidance
  :source/title "OWASP Cryptographic Storage Cheat Sheet"
  :source/publisher "OWASP Cheat Sheet Series"
  :source/url "https://cheatsheetseries.owasp.org/cheatsheets/Cryptographic_Storage_Cheat_Sheet.html"
  :source/verify :page-text
  :page/title "Cryptographic Storage - OWASP Cheat Sheet Series"
  :page/must-contain ["Key Generation"
                      "Key Storage"
                      "Separation of Keys and Data"
                      "NIST SP 800-57"]
  :source/retrieved-at "2026-08-31"
  :source/covers #{:key-storage-practice :key-lifecycle}
  :source/note "Operational practice guidance a self-hosting operator reads
                this mount against -- including its own 'Separation of Keys
                and Data' section, which is the practice this repository's
                custody boundary (engine holds keys, mount never does)
                implements. Cited as guidance, not as a normative standard."}

 ;; ── The Japanese government's cipher list: what an operator may pick ──────

 {:source/id "page.cryptrec-list"
  :source/kind :guidance
  :source/title "CRYPTREC暗号リスト（電子政府推奨暗号リスト）"
  :source/publisher "CRYPTREC (デジタル庁・総務省・経済産業省)"
  :source/url "https://www.cryptrec.go.jp/list.html"
  :source/verify :page-text
  :page/title "CRYPTREC | CRYPTREC暗号リスト(電子政府推奨暗号リスト)"
  :page/must-contain ["電子政府における調達のために参照すべき暗号のリスト"
                      "デジタル庁"]
  :source/retrieved-at "2026-08-31"
  :source/covers #{:cipher-selection :japan-procurement}
  :source/note "The e-government recommended cipher list -- the reference an
                operator in Japan (this mount's operator included) is
                pointed at when choosing ciphers. Which ciphers are on
                which tier is list text and is NOT asserted here; the
                register establishes only that the list exists, is hosted by
                the CRYPTREC project, and is identified correctly."}

 ;; ── HPKE: the hybrid encryption scheme the sealing path reaches for ───────

 {:source/id "rfc.9180"
  :source/kind :protocol
  :source/title "RFC 9180: Hybrid Public Key Encryption (HPKE)"
  :source/publisher "Internet Engineering Task Force / Internet Research Task Force (CFRG)"
  :source/url "https://www.rfc-editor.org/rfc/rfc9180.html"
  :source/verify :page-identity
  :page/title "RFC 9180: Hybrid Public Key Encryption"
  :source/retrieved-at "2026-08-31"
  :source/covers #{:hybrid-encryption :key-encapsulation}
  :source/note "HPKE, the IETF hybrid public-key encryption scheme a
                client-side sealing path is naturally built on -- and the
                instrument that lets a hybrid (classical + ML-KEM) design be

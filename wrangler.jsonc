{
  "name": "kagi",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Uploaded into ai-gftd-repository-dispatch with --dispatch-namespace, so
  // this Worker has no URL of its own. itonami-fleet-dispatch reaches it as
  // the first path segment and strips it:
  //
  //     app.itonami.cloud/kagi/health  ->  this Worker sees /health
  //
  // The script name must stay `kagi`, because the router dispatches on the
  // repository name and blueprint.edn's :itonami.blueprint/mount says "/kagi".
  // Those three agree by being the same string, not by a table.
  //
  // No secrets, and no vault. This surface classifies shapes, checks hash
  // chains and applies the phase gate; unlock material, the VMK, compartment
  // keys and per-item DEKs never leave the owner's machine. There is nothing
  // here for a compromise of this Worker to read.
  "vars": {
    "X402_FACILITATOR": "https://x402.nexus",
    "X402_PAY_TO": "0xA00366234D29d4F882088048c0B2fa0dB7302D4E",
    "X402_NETWORK": "base",
    "X402_DECIDE_USD": "0.001"
  }
}
